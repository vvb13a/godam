{
	admin off
	# Set to "local_certs" in development (see docker-compose.dev.yml) so
	# Caddy's internal CA signs .test/.internal domains instead of public ACME.
	{$CADDY_GLOBAL_OPTIONS}
}

# Consuming application: API, embedded frontend, and authenticated asset routes.
# In hybrid development this points at Vite instead of the godam container.
{$GODAM_DOMAIN} {
	handle /internal/* {
		respond 404
	}

	# Public image delivery is served from the conversion filesystem cache.
	# A miss is proxied to godam, which writes the conversion atomically.
	handle_path /img/* {
		root * {$GODAM_CONVERSION_ROOT:/srv/conversions}
		@cached file {path}
		handle @cached {
			header Cache-Control "public, max-age={$GODAM_DELIVERY_CACHE_TTL:86400}"
			file_server
		}
		handle {
			header Cache-Control "public, max-age={$GODAM_DELIVERY_CACHE_TTL:86400}"
			rewrite * /internal/img-cache{uri}
			reverse_proxy {$GODAM_ASSET_UPSTREAM:godam:8080}
		}
	}

	# Public original delivery is served directly from local asset storage.
	# A miss is proxied to godam for non-local storage drivers.
	handle_path /src/* {
		root * {$GODAM_SOURCE_ROOT:/srv/assets/uploads}
		@cached file {path}.mp4 {path}.webm {path}.mov {path}.m4v {path}.pdf {path}.mp3 {path}.wav {path}.m4a {path}.ogg {path}.oga {path}.opus {path}.flac {path}.aac {path}.mkv {path}.avi
		handle @cached {
			try_files {path}.mp4 {path}.webm {path}.mov {path}.m4v {path}.pdf {path}.mp3 {path}.wav {path}.m4a {path}.ogg {path}.oga {path}.opus {path}.flac {path}.aac {path}.mkv {path}.avi
			header Cache-Control "public, max-age={$GODAM_DELIVERY_CACHE_TTL:86400}"
			header X-Content-Type-Options "nosniff"
			header ?download=1 Content-Disposition "attachment"
			file_server
		}
		handle {
			header Cache-Control "public, max-age={$GODAM_DELIVERY_CACHE_TTL:86400}"
			rewrite * /internal/src-cache{uri}
			reverse_proxy {$GODAM_ASSET_UPSTREAM:godam:8080}
		}
	}

	reverse_proxy {$GODAM_APP_UPSTREAM:godam:8080} {
		# Preset warm-up streams progress over SSE; don't buffer it.
		flush_interval -1
	}
}

# Public conversion origin. Caddy serves cached conversions from the shared
# volume and falls back to godam (which calls imgproxy) on a cache miss.
assets.{$GODAM_DOMAIN} {
	root * {$GODAM_CONVERSION_ROOT:/srv/conversions}
	header Cache-Control "public, max-age={$GODAM_DELIVERY_CACHE_TTL:86400}"

	@miss {
		not file {path}
		path_regexp conversion ^/[^/]+/[^/]+\.(jpe?g|png|webp|gif|avif)$
	}
	handle @miss {
		rewrite * /convert{uri}
		reverse_proxy {$GODAM_ASSET_UPSTREAM:godam:8080}
	}
	handle {
		file_server
	}
}
