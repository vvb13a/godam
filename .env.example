# Domain of the consuming application. godam derives assets.<GODAM_DOMAIN>
# for rendered conversions, so this must be a hostname Caddy can obtain a
# certificate for.
GODAM_DOMAIN=example.com

# imgproxy URL signing. Generate a pair with:
#   openssl rand -hex 32
# Both values must be hex-encoded and match for godam and imgproxy.
IMGPROXY_KEY=
IMGPROXY_SALT=
