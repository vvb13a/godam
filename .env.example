# Domain of the consuming application. This must be a hostname Caddy can
# obtain a certificate for.
GODAM_DOMAIN=example.com

# Optional public origin for /img and /src. Defaults to GODAM_DOMAIN. Set this
# to a separate hostname (for example assets.example.com or cdn.example.com)
# when media should be delivered from its own origin.
GODAM_DELIVERY_DOMAIN=

# imgproxy URL signing. Generate a pair with:
#   openssl rand -hex 32
# Both values must be hex-encoded and match for godam and imgproxy.
# Docker Compose reads the short names; a host-run godam reads GODAM_*.
IMGPROXY_KEY=
IMGPROXY_SALT=
GODAM_IMGPROXY_KEY=
GODAM_IMGPROXY_SALT=

# Enables scoped JWT authentication for embedded pickers/libraries. Leave empty
# to disable JWT auth; requests are then treated as trusted direct access. Generate with:
#   openssl rand -hex 32
GODAM_JWT_SECRET=

# Optional JWT claim checks. When set, tokens must carry the matching iss/aud.
GODAM_JWT_ISSUER=
GODAM_JWT_AUDIENCE=

# Optional fleet-management token for /api/system/info and /metrics.
GODAM_MANAGEMENT_TOKEN=

# Optional overrides.
GODAM_ADDR=:8080
GODAM_LIBRARY_NAME=Library

# Delivery cache lifetime in seconds. Clamped to 60..604800; default 86400.
GODAM_DELIVERY_CACHE_TTL=86400

# Dev-only: host asset storage mounted read-only into Caddy for /src delivery.
# `make dev-stack` derives this automatically from the platform data directory.
# GODAM_HOST_STORAGE_DIR=/path/to/godam/storage
